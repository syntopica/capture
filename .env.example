# Its own database and its own user on nova: no grants anywhere else on that
# server. The service reads nothing but these two tables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# There is no token here. Tokens live in the capture_tokens table as SHA-256
# digests, one row per device, so revoking one is an UPDATE and not a redeploy.
# Mint one with: node scripts/mint-token.mjs "<label>"

# On a cPanel host set DB_SOCKET instead of DB_HOST/DB_PORT. cPanel creates
# database users as user@'localhost', which in MySQL means the unix socket, and
# nova runs with skip_name_resolve = ON, so a TCP connection to 127.0.0.1 is
# matched against a grant that does not exist.
# DB_SOCKET=/var/lib/mysql/mysql.sock
