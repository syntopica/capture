{
  "name": "capture-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "build:cpanel": "bash scripts/build-cpanel.sh",
    "lint": "eslint src *.ts *.mjs --no-warn-ignored --max-warnings 0",
    "lint:fix": "eslint src *.ts *.mjs --no-warn-ignored --fix",
    "lint:suppress": "eslint src *.ts *.mjs --no-warn-ignored --suppress-all",
    "lint:prune": "eslint src *.ts *.mjs --no-warn-ignored --prune-suppressions",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "dupes": "baseline-dupes .",
    "knip": "knip",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes && pnpm knip",
    "deps:graph": "depcruise src scripts",
    "type-coverage": "baseline-type-coverage",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "baseline-audit --level high",
    "check:quality": "pnpm knip && pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check",
    "check:ci": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@syntopica/eslint-config": "^0.10.0",
    "@syntopica/prettier-config": "^0.3.0",
    "@syntopica/quality-config": "^0.15.0",
    "@syntopica/tsconfig": "^0.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-code-policy": "^0.9.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "type-coverage": "^2.30.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
