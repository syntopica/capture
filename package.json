{
  "name": "capture-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "build:cpanel": "bash scripts/build-cpanel.sh",
    "lint": "eslint src *.ts *.mjs --no-warn-ignored --max-warnings 0",
    "lint:fix": "eslint src *.ts *.mjs --no-warn-ignored --fix",
    "lint:suppress": "eslint src *.ts *.mjs --no-warn-ignored --suppress-all",
    "lint:prune": "eslint src *.ts *.mjs --no-warn-ignored --prune-suppressions",
    "fix": "pnpm lint:fix && pnpm format",
    "format": "prettier --write . --list-different",
    "format:check": "prettier --check .",
    "type-check": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dupes": "baseline-dupes .",
    "knip": "knip",
    "check:all": "pnpm type-check && pnpm lint && pnpm format:check && pnpm dupes",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm dupes && pnpm knip",
    "deps:graph": "depcruise src scripts",
    "type-coverage": "baseline-type-coverage --at-least 96.9",
    "secrets:check": "gitleaks detect --no-banner --redact",
    "audit:check": "pnpm audit --audit-level=high",
    "check:quality": "pnpm knip && pnpm deps:graph && pnpm type-coverage",
    "check:security": "pnpm secrets:check && pnpm audit:check"
  },
  "dependencies": {
    "mysql2": "^3.23.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@busirocket/eslint-config": "^0.7.2",
    "@busirocket/prettier-config": "^0.1.2",
    "@busirocket/quality-config": "^0.7.0",
    "@busirocket/tsconfig": "^0.2.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/eslint-plugin": "^1.6.26",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-code-policy": "^0.7.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.7.0",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "type-coverage": "^2.30.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
